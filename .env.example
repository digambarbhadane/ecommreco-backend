# =============================================================================
# EcommReco backend — environment template
# Copy to .env.development | .env.test | .env.uat | .env.production
# NODE_ENV: development | test | staging (loads .env.uat) | production
# =============================================================================

NODE_ENV=development
PORT=5001

# --- App URLs & CORS ---
FRONTEND_URL=http://localhost:8080
FRONTEND_URLS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_ALL=false
CORS_ALLOW_RENDER_ORIGINS=false

# --- MongoDB Atlas ---
# URL-encode password special chars (@ → %40). DB names: ecommreco_dev | _test | _uat | _prod
# MONGODB_URI_STANDARD: use on Windows when mongodb+srv fails (querySrv ECONNREFUSED). Same cluster for all envs.
MONGODB_URI_STANDARD=mongodb://ecommconsultancysurat_db_user:<db_password>@ac-5qg5nr2-shard-00-00.vhp66v6.mongodb.net:27017,ac-5qg5nr2-shard-00-01.vhp66v6.mongodb.net:27017,ac-5qg5nr2-shard-00-02.vhp66v6.mongodb.net:27017/?ssl=true&authSource=admin&retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://ecommconsultancysurat_db_user:<db_password>@cluster0.vhp66v6.mongodb.net/ecommreco_dev?retryWrites=true&w=majority&authSource=admin
MONGODB_DB_NAME=ecommreco_dev
MONGODB_FALLBACK_URI=
USE_MEMORY_DB=false
ALLOW_MEMORY_DB_FALLBACK=false

# --- Auth ---
JWT_SECRET=change-me-use-long-random-string-min-32-chars
SUPER_ADMIN_SETUP_TOKEN=

# --- Email (SMTP) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@ecommreco.com
SMTP_PASS=
EMAIL_FROM_DEFAULT=no-reply@ecommreco.com
EMAIL_FROM_NAME=EcommReco
EMAIL_AUTH=auth@ecommreco.com
EMAIL_BILLING=accounts@ecommreco.com
EMAIL_NOTIFICATION=no-reply@ecommreco.com
EMAIL_SUPPORT=support@ecommreco.com
EMAIL_USE_QUEUE=false
POSTMARK_API_KEY=

# --- API docs ---
ENABLE_SWAGGER=true

# --- GST verification ---
GST_VERIFICATION_EMAIL=info@ecommreco.com
GST_VERIFICATION_CLIENT_ID=
GST_VERIFICATION_CLIENT_SECRET=
GST_VERIFICATION_API_URL=https://api.perione.in/public/search
GST_VERIFICATION_ENV=production

# --- Cashfree payments ---
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_WEBHOOK_SECRET=
# Cashfree return_url = frontend origin; notify_url = API_PUBLIC_URL + /api/v1/webhooks/cashfree
# development: https://dev.ecommreco.com + https://api-dev.ecommreco.com
# uat: https://uat.ecommreco.com + https://api-uat.ecommreco.com
# production: https://ecommreco.com + https://api.ecommreco.com
# local only: http://localhost:8080 + http://localhost:5001
PAYMENT_RETURN_BASE_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:5001

# --- App / company ---
ONBOARDING_V2_ENABLED=true
INVOICE_STORAGE_PATH=storage/invoices
COMPANY_NAME=EcommReco
COMPANY_GSTIN=
COMPANY_ADDRESS=India

# --- Dev / CI super admin (non-production only) ---
DEV_SUPER_ADMIN_EMAIL=superadmin@example.com
DEV_SUPER_ADMIN_PASSWORD=password123
