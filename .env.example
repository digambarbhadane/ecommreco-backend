# =============================================================================
# EcommReco backend — environment template
# Copy to .env.development | .env.test | .env.uat | .env.production
# NODE_ENV: development | test | staging (loads .env.uat) | production
# SECURITY CLASSIFICATION:
# - PUBLIC CONFIG: non-secret runtime config values
# - SERVER SECRET: backend-only secret; never expose to frontend
# - SECURITY SECRET: credentials/keys; rotate and store securely
# =============================================================================

NODE_ENV=development
PORT=5001

# --- App URLs & CORS (PUBLIC CONFIG) ---
FRONTEND_URL=http://localhost:8080
FRONTEND_URLS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_ALL=false
CORS_ALLOW_RENDER_ORIGINS=false

# --- MongoDB Atlas (SECURITY SECRET) ---
# URL-encode password special chars (@ → %40). DB names: ecommreco_dev | _test | _uat | _prod
# MONGODB_URI_STANDARD: use on Windows when mongodb+srv fails (querySrv ECONNREFUSED). Same cluster for all envs.
MONGODB_URI_STANDARD=mongodb://ecommconsultancysurat_db_user:<db_password>@ac-5qg5nr2-shard-00-00.vhp66v6.mongodb.net:27017,ac-5qg5nr2-shard-00-01.vhp66v6.mongodb.net:27017,ac-5qg5nr2-shard-00-02.vhp66v6.mongodb.net:27017/?ssl=true&tls=true&authSource=admin&replicaSet=atlas-105vpd-shard-0&retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://ecommconsultancysurat_db_user:<db_password>@cluster0.vhp66v6.mongodb.net/ecommreco_dev?retryWrites=true&w=majority&authSource=admin
MONGODB_DB_NAME=ecommreco_dev
MONGODB_FALLBACK_URI=
USE_MEMORY_DB=false
ALLOW_MEMORY_DB_FALLBACK=false

# --- Auth (SERVER SECRET / SECURITY SECRET) ---
JWT_SECRET=change-me-use-long-random-string-min-32-chars
SUPER_ADMIN_SETUP_TOKEN=
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/api/v1/auth

# --- Email (SECURITY SECRET) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@ecommreco.com
SMTP_PASS=
EMAIL_FROM_DEFAULT=no-reply@ecommreco.com
EMAIL_FROM_NAME=EcommReco
EMAIL_AUTH=auth@ecommreco.com
EMAIL_BILLING=accounts@ecommreco.com
EMAIL_NOTIFICATION=no-reply@ecommreco.com
EMAIL_SUPPORT=support@ecommreco.com
EMAIL_USE_QUEUE=false
POSTMARK_API_KEY=

# --- API docs (PUBLIC CONFIG) ---
ENABLE_SWAGGER=true

# --- GST verification (SECURITY SECRET) ---
GST_VERIFICATION_EMAIL=info@ecommreco.com
GST_VERIFICATION_CLIENT_ID=
GST_VERIFICATION_CLIENT_SECRET=
GST_VERIFICATION_API_URL=https://api.perione.in/public/search
GST_VERIFICATION_ENV=production

# --- Cashfree payments (SECURITY SECRET) ---
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_WEBHOOK_SECRET=
# Cashfree return_url = frontend origin; notify_url = API_PUBLIC_URL + /api/v1/webhooks/cashfree
# development: https://dev.ecommreco.com + https://api-dev.ecommreco.com
# uat: https://uat.ecommreco.com + https://api-uat.ecommreco.com
# production: https://ecommreco.com + https://api.ecommreco.com
# local only: http://localhost:8080 + http://localhost:5001
PAYMENT_RETURN_BASE_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:5001

# --- SMS / MSG91 (SECURITY SECRET) ---
# log = dev (OTP delivery logged on server, OTP never logged); msg91 = MSG91 Flow API
SMS_PROVIDER=log
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=ECMRCO
# MSG91 OTP Widget — server verifies OTP with widgetId + tokenAuth (recommended)
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
# Optional: reCAPTCHA Enterprise site key when MSG91 widget captcha is enabled (type 1)
MSG91_RECAPTCHA_SITE_KEY=
# true = do not require Google reCAPTCHA (needed on localhost; MSG91's key rejects local domains)
MSG91_SKIP_CAPTCHA=
# Legacy aliases (still supported)
MSG91_API_KEY=
MSG91_OTP_TEMPLATE_ID=

# --- OTP (PUBLIC CONFIG) ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_SEND_ATTEMPTS=3
OTP_SEND_WINDOW_MINUTES=15
OTP_BLOCK_MINUTES=15
OTP_RESEND_INTERVAL_SECONDS=30
OTP_VERIFICATION_PROOF_MINUTES=15

# --- App / company (PUBLIC CONFIG) ---
ONBOARDING_V2_ENABLED=true
INVOICE_STORAGE_PATH=storage/invoices
COMPANY_NAME=EcommReco
COMPANY_GSTIN=
COMPANY_ADDRESS=India

# --- Dev / CI super admin (SERVER SECRET, non-production only) ---
DEV_SUPER_ADMIN_EMAIL=superadmin@example.com
DEV_SUPER_ADMIN_PASSWORD=password123
